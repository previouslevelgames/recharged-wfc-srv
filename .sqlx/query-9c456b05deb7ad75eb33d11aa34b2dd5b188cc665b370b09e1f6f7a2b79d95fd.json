{
  "db_name": "PostgreSQL",
  "query": "SELECT p.profile_id, p.user_id, p.gsbrcd, p.ingamesn, p.created_at, p.last_login_at,\n                  p.last_ip, p.unique_nick, p.lastname,\n                  players.player_id AS \"player_id?\", players.display_name AS \"player?\",\n                  discord.username AS \"discord?\"\n           FROM profiles p\n           LEFT JOIN player_wfc_profiles bound ON bound.profile_id = p.profile_id\n           LEFT JOIN players ON players.player_id = bound.player_id\n           LEFT JOIN player_identities discord\n                  ON discord.player_id = players.player_id AND discord.provider = 'discord'\n           WHERE p.profile_id = $1",
