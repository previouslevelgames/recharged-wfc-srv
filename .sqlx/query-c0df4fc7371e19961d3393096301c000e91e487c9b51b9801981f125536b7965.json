  "query": "SELECT started_at,\n                  CASE WHEN state = 'abandoned' THEN last_report_at ELSE ended_at END AS ended_at\n           FROM online_matches\n           WHERE state = 'in_progress' OR ended_at >= $1\n           ORDER BY started_at DESC\n           LIMIT $2",
