  "query": "SELECT profile_id, region, score, userdata, updated_at,\n                              floor(extract(epoch FROM now() - updated_at) / 60)::bigint AS \"minutes!\"\n                       FROM scores\n                       WHERE category = $1 AND updated_at >= $2\n                       ORDER BY score ASC, updated_at, profile_id",
