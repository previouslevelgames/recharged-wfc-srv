# Container environment variables (also add these in the Unraid container editor).
# Required password: generate with openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=recharged_wfc
POSTGRES_USER=recharged_wfc

# Admin dashboard at /admin (docs/install.md, "Admin dashboard"). Set all four, or none.
# The HTTPS address browsers use, without a path; Google returns to
# <PUBLIC_URL>/admin/callback.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google addresses allowed in, comma-separated.
ADMIN_GOOGLE_EMAILS=
# Optional: owners, above admins. They sign in too, and only they see the
# Maintenance page (wipe the leaderboards). Comma-separated.
OWNER_GOOGLE_EMAILS=

# Profiles, players who sign in from the launcher (docs/profiles.md). The
# Discord app's client; Discord returns to <PUBLIC_URL>/sign-in/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# true: sign in with a name alone, for tests on one PC. Never on a public server.
PROFILES_TEST_SIGN_IN=
# A short name such as DEV that /admin and the sign-in pages show, for a test
# server. Unset: none.
SERVER_LABEL=

# The relay for games that cannot reach each other (docs/install.md, NAT relay):
# the IPv4 address or host name the games reach this server at, as in their
# online.server. Unset: no relay. NATNEG_RELAY: auto (default), always or off.
NATNEG_RELAY_ADDRESS=
NATNEG_RELAY=
NATNEG_RELAY_MAX=

# Days of daily log files to keep. Default: 14.
LOG_RETENTION_DAYS=

# Docker Compose settings; these configure the image and host mappings.
SERVER_IMAGE=ghcr.io/previouslevelgames/recharged-wfc-srv:latest
# The game sends NAS and gamestats2 requests to port 80.
HTTP_PORT=80
# On Unraid, use /mnt/user/appdata/recharged-wfc-srv/postgres
POSTGRES_DATA_DIR=./data/postgres
# The server's log files. On Unraid, use /mnt/user/appdata/recharged-wfc-srv/logs
LOG_DATA_DIR=./data/logs
