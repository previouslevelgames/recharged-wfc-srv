# Container environment variables (also add these in the Unraid container editor).
# Required password: generate with openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=recharged_wfc
POSTGRES_USER=recharged_wfc

# Admin dashboard at /admin (README, "Admin dashboard"). Set all four, or none.
# The HTTPS address browsers use, without a path; Google returns to
# <PUBLIC_URL>/admin/callback.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google addresses allowed in, comma-separated.
ADMIN_GOOGLE_EMAILS=

# Docker Compose settings; these configure the image and host mappings.
SERVER_IMAGE=ghcr.io/previouslevelgames/recharged-wfc-srv:latest
# The game sends NAS and gamestats2 requests to port 80.
HTTP_PORT=80
# On Unraid, use /mnt/user/appdata/recharged-wfc-srv/postgres
POSTGRES_DATA_DIR=./data/postgres
